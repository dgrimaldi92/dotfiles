
// ~/.config/fastfetch/config.jsonc
// Place banner.txt in ~/.config/fastfetch/banner.txt
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "~/.config/fastfetch/banner.txt",
    "type": "file-raw",
    // Tune these if the banner collides with or overlaps the info column
    "padding": {
      "top": 1,
      "left": 2
    }
  },

  // "display": {
  //   "separator": "  ",
  //   "color": {
  //     "keys":  "cyan",
  //     "title": "cyan"
  //   },
  //   "size": {
  //     "ndigits": 2
  //   }
  // },

 "display": {
    "separator": " "
  },
  "modules": [
   "break",
    {
      "type": "host",
      "key": "󰌢 ",
      "keyColor": "34",
      "format": "{1}"
    },
    {
      "type": "separator",
      "string": "───────────────────────────────"
    },
    {
      "type": "os",
      "key": "󰌽 ",
      "keyColor": "34"
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "34",
      "format": "{1}"
    },
    {
      "type": "uptime",
      "key": "󰅐 ",
      "keyColor": "34"
    },
    {
      "type": "packages",
      "key": "󰏖 ",
      "keyColor": "34"
    },
    {
      "type": "cpu",
      "key": " ",
      "keyColor": "34",
      "showPeCoreCount": true,
      "temp": true,
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "󰢮 ",
      "keyColor": "34",
      "driverSpecific": true,
      "temp": true
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "34"
    },
    {
      "type": "swap",
      "key": "󰓡 ",
      "keyColor": "34"
    },
    {
      "type": "disk",
      "key": "󰋊 ",
      "keyColor": "34",
      "folders": "/",
      "format": "{1}"
    },
    {
      "type": "separator",
      "string": "───────────────────────────────"
    },
    {
      "type": "wm",
      "key": "󱇛 ",
      "keyColor": "34"
    },
    {
      "type": "de",
      "key": "󰧨 ",
      "keyColor": "34"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "34"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "34",
      "format": "{1}"
    },
    {
      "type": "display",
      "key": "󰍹 ",
      "keyColor": "34"
    },
    {
      "type": "locale",
      "key": "󰗊 ",
      "keyColor": "34"
    },
        {
            "key": "Local IP",
            "keyColor": "red",
            "type": "localip",
            "compact": true
        },
        {
            "key": "Public IP",
            "keyColor": "cyan",
            "type": "publicip",
            "timeout": 1000
        }, {
            "key": "│ {#36}󰩟 network {#keys}│",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"  ]

}

