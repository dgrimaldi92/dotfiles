#!/bin/bash

active=$(hyprctl activewindow -j)
addr=$(echo "$active" | jaq -r ".address")
window="address:$addr"

# Get monitor information for the current window
monitor_info=$(hyprctl activewindow -j | jaq '.[0]')
width=$(echo "$monitor_info" | jaq -r ".width")
height=$(echo "$monitor_info" | jaq -r ".height")
scale=$(echo "$monitor_info" | jaq -r ".scale")

# Scale-aware logical pixels (Hyprland works in logical coords)
log_width=$(echo "$width $scale" | awk '{printf "%d", $1 / $2}')
log_height=$(echo "$height $scale" | awk '{printf "%d", $1 / $2}')

hypr_dispatch() {
  hyprctl dispatch "$1" >/dev/null 2>&1 || hyprctl dispatch "$2" >/dev/null
}

hypr_dispatch \
  "hl.dsp.window.float({ window = \"$window\", action = \"set\" })" \
  "togglefloating $window"

hypr_dispatch \
  "hl.dsp.window.resize({ window = \"$window\", x = $log_width, y = $log_height })" \
  "resizewindowpixel exact $log_width $log_height,$window"

hypr_dispatch \
  "hl.dsp.window.move({ window = \"$window\", x = 0, y = 0 })" \
  "movewindowpixel exact 0 0,$window"
