#!/bin/bash
WALLPAPER_DIR="$HOME/.config/theme/backgrounds/"

echo "Directory $#"
if [[ $# -eq 0 ]]; then
  # Pick a random image from the directory
  path=$(find "$WALLPAPER_DIR" -type f | shuf -n 1)
else
  path=$(realpath "$1")
fi

echo "Wallpaper: $path"
# Kill existing swaybg and start new one
hyprctl hyprpaper wallpaper ,"$path"
# hyprctl hyprpaper wallpaper , /home/dav/.config/theme/backgrounds/5-oma.jpg
