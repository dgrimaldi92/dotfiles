#!/usr/bin/env python3
"""Thin AnkiConnect CLI. Stdlib only. Terse output by design — every byte
lands in an agent's context window.

Requires the AnkiConnect add-on (code 2055492159) and Anki running.
Override the endpoint with ANKI_CONNECT_URL.
"""
import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.request

URL = os.environ.get("ANKI_CONNECT_URL", "http://127.0.0.1:8765")
API = 6


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def call(action, **params):
    payload = json.dumps({"action": action, "version": API, "params": params})
    req = urllib.request.Request(
        URL, data=payload.encode("utf-8"),
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            body = json.load(resp)
    except urllib.error.URLError as e:
        die(f"unreachable: {URL} ({e.reason}). Is Anki open with AnkiConnect installed?")
    except json.JSONDecodeError:
        die(f"bad response from {URL}")
    if body.get("error"):
        die(f"anki error: {body['error']}")
    return body.get("result")


# --- text handling -----------------------------------------------------------

_BREAK = re.compile(r"<\s*(br|/div|/p|/li)\s*/?\s*>", re.I)
_TAGS = re.compile(r"<[^>]+>")
_WS = re.compile(r"[ \t\u00a0]+")
_ENT = {
    "&nbsp;": " ", "&amp;": "&", "&lt;": "<", "&gt;": ">",
    "&quot;": '"', "&#39;": "'", "&apos;": "'",
}


def flatten(s, limit=None):
    """HTML field -> single-line plain text."""
    if not s:
        return ""
    s = _BREAK.sub(" / ", s)
    s = _TAGS.sub("", s)
    for k, v in _ENT.items():
        s = s.replace(k, v)
    s = _WS.sub(" ", s.replace("\n", " ")).strip()
    if limit and len(s) > limit:
        s = s[: limit - 1].rstrip() + "\u2026"
    return s


def deck_filter(deck):
    return f'deck:"{deck}" ' if deck else ""


def require_deck(deck, create):
    existing = call("deckNames")
    if deck in existing:
        return
    if not create:
        die(f'no deck "{deck}". Pass --create, or check `anki decks`.')
    call("createDeck", deck=deck)


def split_tags(raw):
    if not raw:
        return []
    return [t for t in re.split(r"[\s,]+", raw) if t]


def note_payload(deck, item, default_tags):
    """Build an AnkiConnect note from a dict."""
    kind = (item.get("type") or ("cloze" if "text" in item else "basic")).lower()
    tags = item.get("tags")
    if isinstance(tags, str):
        tags = split_tags(tags)
    tags = (tags or []) + default_tags
    if kind == "cloze":
        text = item.get("text") or item.get("front")
        if not text:
            die(f"cloze note missing 'text': {item}")
        if "{{c" not in text:
            die(f"cloze note has no {{{{c1::...}}}} deletion: {flatten(text, 60)}")
        fields = {"Text": text, "Back Extra": item.get("extra", "")}
        model = item.get("model", "Cloze")
    else:
        if not (item.get("front") and item.get("back")):
            die(f"basic note needs 'front' and 'back': {item}")
        fields = {"Front": item["front"], "Back": item["back"]}
        model = item.get("model", "Basic")
    return {
        "deckName": item.get("deck", deck),
        "modelName": model,
        "fields": fields,
        "tags": sorted(set(tags)),
        "options": {"allowDuplicate": False,
                    "duplicateScope": "deck"},
    }


# --- commands ----------------------------------------------------------------

def cmd_ping(a):
    print(f"ok  AnkiConnect v{call('version')}  {URL}")


def cmd_decks(a):
    stats = call("getNumCardsReviewedToday")
    names = sorted(call("deckNames"))
    for n in names:
        due = len(call("findCards", query=f'deck:"{n}" is:due'))
        total = len(call("findCards", query=f'deck:"{n}"'))
        print(f"{due:>5} due  {total:>6} tot  {n}")
    print(f"# reviewed today: {stats}", file=sys.stderr)


def cmd_due(a):
    q = deck_filter(a.deck) + ("is:due" if not a.new else "(is:due or is:new)")
    if a.tag:
        q += f' tag:{a.tag}'
    ids = call("findCards", query=q)
    if not ids:
        print("nothing due")
        return
    ids = ids[: a.n]
    limit = None if a.full else 220
    for c in call("cardsInfo", cards=ids):
        fields = list(c["fields"].items())
        front = flatten(fields[0][1]["value"], limit)
        back = " | ".join(
            flatten(v["value"], limit) for _, v in fields[1:] if v["value"].strip()
        )
        print(f"{c['cardId']}\t{c['deckName']}\tQ: {front}\tA: {back}")


def cmd_add(a):
    require_deck(a.deck, a.create)
    item = ({"type": "cloze", "text": a.text, "extra": a.extra or ""}
            if a.text else
            {"type": "basic", "front": a.front, "back": a.back})
    nid = call("addNote", note=note_payload(a.deck, item, split_tags(a.tags)))
    print(f"added {nid}")


def cmd_batch(a):
    raw = sys.stdin.read() if a.file == "-" else open(a.file, encoding="utf-8").read()
    try:
        items = json.loads(raw)
    except json.JSONDecodeError as e:
        die(f"bad JSON: {e}")
    if isinstance(items, dict):
        items = items.get("notes", [])
    if not items:
        die("no notes in input")
    default_tags = split_tags(a.tags)
    notes = [note_payload(a.deck, i, default_tags) for i in items]
    if not a.dry_run:
        require_deck(a.deck, a.create)
    if a.dry_run:
        for n in notes:
            first = next(iter(n["fields"].values()))
            print(f"[{n['modelName']}] {flatten(first, 100)}")
        print(f"# {len(notes)} notes, not sent (--dry-run)", file=sys.stderr)
        return
    result = call("addNotes", notes=notes)
    ok = [r for r in result if r]
    print(f"added {len(ok)}/{len(notes)}")
    for n, r in zip(notes, result):
        if r is None:
            first = next(iter(n["fields"].values()))
            print(f"  skipped (duplicate/invalid): {flatten(first, 90)}")


def cmd_find(a):
    ids = call("findNotes", query=a.query)
    if not ids:
        print("no matches")
        return
    for n in call("notesInfo", notes=ids[: a.n]):
        fields = list(n["fields"].items())
        first = flatten(fields[0][1]["value"], 160)
        tags = ",".join(n["tags"])
        print(f"{n['noteId']}\t{first}\t[{tags}]")
    if len(ids) > a.n:
        print(f"# {len(ids)} total, showing {a.n}", file=sys.stderr)


def cmd_tag(a):
    ids = call("findNotes", query=a.query)
    if not ids:
        die("query matched nothing")
    tags = " ".join(split_tags(a.tags))
    call("removeTags" if a.remove else "addTags", notes=ids, tags=tags)
    verb = "removed from" if a.remove else "added to"
    print(f"{tags} {verb} {len(ids)} notes")


def cmd_answer(a):
    if not 1 <= a.ease <= 4:
        die("ease must be 1 (again) 2 (hard) 3 (good) 4 (easy)")
    answers = [{"cardId": int(c), "ease": a.ease} for c in a.cards]
    result = call("answerCards", answers=answers)
    good = sum(1 for r in result if r)
    print(f"graded {good}/{len(answers)} ease={a.ease}")


def cmd_suspend(a):
    ids = call("findCards", query=a.query)
    if not ids:
        die("query matched nothing")
    call("unsuspend" if a.unsuspend else "suspend", cards=ids)
    print(f"{'unsuspended' if a.unsuspend else 'suspended'} {len(ids)} cards")


def cmd_sync(a):
    call("sync")
    print("sync requested (Anki may still be queueing it)")


def cmd_models(a):
    for m in sorted(call("modelNames")):
        fields = call("modelFieldNames", modelName=m)
        print(f"{m}\t{', '.join(fields)}")


# --- wiring ------------------------------------------------------------------

def main():
    p = argparse.ArgumentParser(prog="anki", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("ping", help="check AnkiConnect is reachable").set_defaults(fn=cmd_ping)
    sub.add_parser("decks", help="list decks with due/total counts").set_defaults(fn=cmd_decks)
    sub.add_parser("models", help="list note types and their fields").set_defaults(fn=cmd_models)
    sub.add_parser("sync", help="trigger AnkiWeb sync").set_defaults(fn=cmd_sync)

    d = sub.add_parser("due", help="cards due for review")
    d.add_argument("-d", "--deck")
    d.add_argument("-n", type=int, default=10)
    d.add_argument("-t", "--tag")
    d.add_argument("--new", action="store_true", help="include unseen cards")
    d.add_argument("--full", action="store_true", help="do not truncate fields")
    d.set_defaults(fn=cmd_due)

    ad = sub.add_parser("add", help="add one note")
    ad.add_argument("-d", "--deck", required=True)
    ad.add_argument("--front")
    ad.add_argument("--back")
    ad.add_argument("--text", help="cloze text with {{c1::...}}")
    ad.add_argument("--extra", help="cloze Back Extra")
    ad.add_argument("--tags")
    ad.add_argument("--create", action="store_true")
    ad.set_defaults(fn=cmd_add)

    b = sub.add_parser("batch", help="add many notes from JSON (file or - for stdin)")
    b.add_argument("file")
    b.add_argument("-d", "--deck", required=True)
    b.add_argument("--tags", help="tags applied to every note")
    b.add_argument("--create", action="store_true")
    b.add_argument("--dry-run", action="store_true")
    b.set_defaults(fn=cmd_batch)

    f = sub.add_parser("find", help="search notes (Anki query syntax)")
    f.add_argument("query")
    f.add_argument("-n", type=int, default=20)
    f.set_defaults(fn=cmd_find)

    t = sub.add_parser("tag", help="add or remove tags on matching notes")
    t.add_argument("query")
    t.add_argument("tags")
    t.add_argument("--remove", action="store_true")
    t.set_defaults(fn=cmd_tag)

    an = sub.add_parser("answer", help="grade cards 1=again 2=hard 3=good 4=easy")
    an.add_argument("cards", nargs="+")
    an.add_argument("-e", "--ease", type=int, required=True)
    an.set_defaults(fn=cmd_answer)

    s = sub.add_parser("suspend", help="suspend cards matching a query")
    s.add_argument("query")
    s.add_argument("--unsuspend", action="store_true")
    s.set_defaults(fn=cmd_suspend)

    a = p.parse_args()
    if a.cmd == "add" and not (a.text or (a.front and a.back)):
        p.error("add needs --text (cloze) or both --front and --back")
    a.fn(a)


if __name__ == "__main__":
    main()
