#!/usr/bin/env python3
"""xmind2md — convert .xmind files to Markdown. Stdlib only.

Handles both container formats:
  content.json  XMind Zen / 2020+ / 2021+
  content.xml   XMind 8 and earlier

Usage:
  xmind2md lezione.xmind                 # to stdout
  xmind2md lezione.xmind -o lezione.md
  xmind2md *.xmind --outdir appunti/
  xmind2md file.xmind --bullets          # no headings, pure nested list
  xmind2md file.xmind --heading-depth 3  # H1..H3 then bullets (default 2)

Multi-sheet files:
  xmind2md file.xmind -l                 # list sheets and node counts
  xmind2md file.xmind -s 2               # only sheet 2
  xmind2md file.xmind -s shock -s edema  # by name substring
  xmind2md file.xmind --split --outdir appunti/   # one .md per sheet
"""

import argparse
import json
import os
import re
import sys
import xml.etree.ElementTree as ET
import zipfile

NS = {"x": "urn:xmind:xmap:xmlns:content:2.0"}


# --- extraction --------------------------------------------------------------


def read_container(path):
    """Return ('json'|'xml', parsed) from a .xmind archive or bare file."""
    if not zipfile.is_zipfile(path):
        # Some tools emit a bare content.json named .xmind
        with open(path, encoding="utf-8") as fh:
            return "json", json.load(fh)
    with zipfile.ZipFile(path) as z:
        names = set(z.namelist())
        if "content.json" in names:
            return "json", json.loads(z.read("content.json").decode("utf-8"))
        if "content.xml" in names:
            return "xml", ET.fromstring(z.read("content.xml").decode("utf-8"))
    raise ValueError(f"{path}: no content.json or content.xml inside")


class Node:
    __slots__ = ("title", "note", "labels", "href", "children")

    def __init__(self, title, note="", labels=None, href=None, children=None):
        self.title = title
        self.note = note
        self.labels = labels or []
        self.href = href
        self.children = children or []


def from_json_topic(t):
    notes = t.get("notes") or {}
    plain = (notes.get("plain") or {}).get("content", "")
    if not plain:
        # richer note formats keep text under html/content
        html = (notes.get("html") or {}).get("content", "")
        plain = re.sub(r"<[^>]+>", "", html) if isinstance(html, str) else ""
    kids = t.get("children") or {}
    attached = kids.get("attached") or []
    detached = kids.get("detached") or []
    return Node(
        title=(t.get("title") or "").strip(),
        note=plain.strip(),
        labels=t.get("labels") or [],
        href=t.get("href"),
        children=[from_json_topic(c) for c in list(attached) + list(detached)],
    )


def from_xml_topic(t):
    title_el = t.find("x:title", NS)
    title = (title_el.text or "").strip() if title_el is not None else ""
    note = ""
    note_el = t.find("x:notes/x:plain", NS)
    if note_el is not None and note_el.text:
        note = note_el.text.strip()
    labels = [
        (el.text or "").strip() for el in t.findall("x:labels/x:label", NS) if el.text
    ]
    children = []
    for group in t.findall("x:children/x:topics", NS):
        children.extend(from_xml_topic(c) for c in group.findall("x:topic", NS))
    return Node(
        title,
        note,
        labels,
        t.get("{urn:xmind:xmap:xmlns:content:2.0}href") or t.get("href"),
        children,
    )


def sheets(path):
    """Yield (sheet_title, root_node) for every sheet in the file."""
    kind, doc = read_container(path)
    if kind == "json":
        entries = doc if isinstance(doc, list) else [doc]
        for i, sheet in enumerate(entries, 1):
            root = sheet.get("rootTopic")
            if not root:
                continue
            yield (sheet.get("title") or f"Sheet {i}").strip(), from_json_topic(root)
    else:
        for i, sheet in enumerate(doc.findall("x:sheet", NS), 1):
            root = sheet.find("x:topic", NS)
            if root is None:
                continue
            st = sheet.find("x:title", NS)
            name = (st.text or "").strip() if st is not None else f"Sheet {i}"
            yield name, from_xml_topic(root)


# --- rendering ---------------------------------------------------------------


def esc(s):
    """Escape Markdown structural characters that would misrender inline."""
    return re.sub(r"^([#>\-*+]|\d+\.)\s", r"\\\1 ", s)


def label_str(node):
    return f"  `{'` `'.join(node.labels)}`" if node.labels else ""


def link(node):
    if node.href and node.href.startswith(("http://", "https://")):
        return f" ([link]({node.href}))"
    return ""


def render(node, out, depth, heading_depth, bullets_only, offset=0):
    title = esc(node.title) or "*(senza titolo)*"
    inline = f"{title}{label_str(node)}{link(node)}"

    if not bullets_only and depth < heading_depth:
        out.append(f"{'#' * (depth + 1 + offset)} {inline}")
        out.append("")
        if node.note:
            out.extend([f"> {ln}" for ln in node.note.splitlines()] + [""])
        for c in node.children:
            render(c, out, depth + 1, heading_depth, bullets_only, offset)
        if node.children and depth + 1 >= heading_depth:
            out.append("")
    else:
        base = 0 if bullets_only else heading_depth
        indent = "  " * (max(0, depth - base) + (offset if bullets_only else 0))
        out.append(f"{indent}- {inline}")
        if node.note:
            for ln in node.note.splitlines():
                out.append(f"{indent}  > {ln}")
        for c in node.children:
            render(c, out, depth + 1, heading_depth, bullets_only, offset)


def slug(s):
    s = re.sub(r"[^\w\s-]", "", s, flags=re.UNICODE).strip()
    return re.sub(r"[\s_]+", "-", s).lower() or "foglio"


def select(found, want):
    """Filter sheets by 1-based index or case-insensitive name substring."""
    if not want:
        return found
    picked = []
    for w in want:
        if w.isdigit():
            i = int(w)
            if not 1 <= i <= len(found):
                raise ValueError(f"no sheet {i} (file has {len(found)})")
            picked.append(found[i - 1])
        else:
            hits = [s for s in found if w.lower() in s[0].lower()]
            if not hits:
                names = ", ".join(n for n, _ in found)
                raise ValueError(f'no sheet matching "{w}". Sheets: {names}')
            picked.extend(hits)
    seen, unique = set(), []
    for name, root in picked:
        if id(root) not in seen:
            seen.add(id(root))
            unique.append((name, root))
    return unique


def render_sheet(name, root, heading_depth, bullets_only, with_title):
    out = []
    offset = 0
    if with_title:
        if bullets_only:
            out.append(f"- **{esc(name)}**")
            offset = 1
        else:
            out.extend([f"# {esc(name)}", ""])
            offset = 1
    render(root, out, 0, heading_depth, bullets_only, offset)
    return out


def tidy(lines):
    return re.sub(r"\n{3,}", "\n\n", "\n".join(lines)).strip() + "\n"


def convert(path, heading_depth, bullets_only, want=None, sheet_titles=None):
    found = list(sheets(path))
    if not found:
        raise ValueError(f"{path}: no sheets found")
    chosen = select(found, want)
    # Title each sheet when more than one ends up in the same document,
    # unless explicitly overridden.
    with_title = len(chosen) > 1 if sheet_titles is None else sheet_titles
    out = []
    for name, root in chosen:
        out.extend(render_sheet(name, root, heading_depth, bullets_only, with_title))
    return tidy(out)


def convert_split(path, heading_depth, bullets_only, want=None):
    """Yield (sheet_index, sheet_name, markdown) one document per sheet."""
    found = list(sheets(path))
    if not found:
        raise ValueError(f"{path}: no sheets found")
    for name, root in select(found, want):
        idx = next(i for i, (n, r) in enumerate(found, 1) if r is root)
        yield (
            idx,
            name,
            tidy(render_sheet(name, root, heading_depth, bullets_only, True)),
        )


def main():
    p = argparse.ArgumentParser(
        prog="xmind2md",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("files", nargs="+")
    p.add_argument("-o", "--output", help="write here (single input only)")
    p.add_argument("--outdir", help="write <name>.md per input file")
    p.add_argument(
        "--heading-depth",
        type=int,
        default=2,
        help="levels rendered as headings before switching to bullets (default 2)",
    )
    p.add_argument(
        "--bullets", action="store_true", help="no headings at all, one nested list"
    )
    p.add_argument(
        "-l",
        "--list",
        action="store_true",
        help="list the sheets in each file and exit",
    )
    p.add_argument(
        "-s",
        "--sheet",
        action="append",
        metavar="N|NAME",
        help="convert only this sheet; repeatable, index or name substring",
    )
    p.add_argument(
        "--split", action="store_true", help="one .md per sheet (needs --outdir)"
    )
    p.add_argument(
        "--no-sheet-titles",
        dest="sheet_titles",
        action="store_false",
        default=None,
        help="do not emit a heading per sheet",
    )
    a = p.parse_args()

    if a.output and len(a.files) > 1:
        p.error("-o takes a single input; use --outdir for several")
    if a.split and not a.outdir:
        p.error("--split needs --outdir")

    if a.list:
        for f in a.files:
            try:
                found = list(sheets(f))
            except Exception as e:
                print(f"skip {f}: {e}", file=sys.stderr)
                continue
            print(f)
            for i, (name, root) in enumerate(found, 1):
                n = 0
                stack = [root]
                while stack:
                    t = stack.pop()
                    n += 1
                    stack.extend(t.children)
                print(f"  {i}. {name}  ({n} nodi, radice: {root.title or '—'})")
        return

    failed = False
    for f in a.files:
        try:
            if a.split:
                os.makedirs(a.outdir, exist_ok=True)
                stem = os.path.splitext(os.path.basename(f))[0]
                for idx, name, md in convert_split(
                    f, a.heading_depth, a.bullets, a.sheet
                ):
                    dest = os.path.join(a.outdir, f"{stem}--{idx:02d}-{slug(name)}.md")
                    with open(dest, "w", encoding="utf-8") as fh:
                        fh.write(md)
                    print(f"{f} [{name}] -> {dest}", file=sys.stderr)
                continue
            md = convert(f, a.heading_depth, a.bullets, a.sheet, a.sheet_titles)
        except (
            ValueError,
            KeyError,
            ET.ParseError,
            json.JSONDecodeError,
            zipfile.BadZipFile,
            OSError,
        ) as e:
            print(f"skip {f}: {e}", file=sys.stderr)
            failed = True
            continue

        if a.outdir:
            os.makedirs(a.outdir, exist_ok=True)
            dest = os.path.join(
                a.outdir, os.path.splitext(os.path.basename(f))[0] + ".md"
            )
        elif a.output:
            dest = a.output
        else:
            sys.stdout.write(md)
            continue

        with open(dest, "w", encoding="utf-8") as fh:
            fh.write(md)
        print(f"{f} -> {dest}", file=sys.stderr)

    if failed:
        sys.exit(1)


if __name__ == "__main__":
    main()
