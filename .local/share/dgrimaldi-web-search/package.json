{
  "name": "dgrimaldi-web-search",
  "version": "1.0.0",
  "description": "A web search extension for pi",
  "keywords": [
    "pi-package"
  ],
  "main": "./extensions/src/index.ts",
  "scripts": {
    "check": "npm run typecheck && npm run test",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "typebox": "^0.31.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typebox": "^1.1.38",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "compilerOptions": {
    "baseUrl": "./extensions/"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  }
}
